# Auto-detectar archivos de texto y normalizar finales de línea a LF
* text=auto eol=lf

# Archivos de código fuente y configuración
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.env.example text eol=lf

# Scripts y contenedores Linux
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf

# Archivos binarios
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
