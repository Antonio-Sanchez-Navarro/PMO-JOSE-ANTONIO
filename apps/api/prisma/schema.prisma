// Esquema de datos del PMO Dashboard — ver ARCHITECTURE.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  POSTPONED
  DONE
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// De dónde salió la tarea. `EMAIL` es la única que el reproceso automático
/// puede borrar y recrear; el resto son de una persona y no se tocan.
enum TaskSource {
  EMAIL
  WHATSAPP
  MANUAL
}

/// En qué punto del triage está el correo (Inbox Zero).
///
/// Es una decisión de la persona y no del sistema: `processedAt` dice que el
/// worker ya lo analizó, que es otra cosa. Un correo puede estar procesado por
/// la IA y seguir `PENDING` para su dueño.
enum EmailStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  googleTokens   String? // cifrado en reposo (AES-256-GCM)
  /// Último `historyId` de Gmail sincronizado: punto de partida de la sync incremental.
  gmailHistoryId String?
  whatsappNumber String?
  role           String       @default("owner")
  createdAt      DateTime     @default(now())
  emails         Email[]
  tasks          Task[]
  timeEntries    TimeEntry[]
  tags           Tag[]
  chatThreads    ChatThread[]
  copilotAudit   CopilotAuditLog[]
}

/// Quién dijo cada cosa en una conversación con el copiloto.
enum ChatRole {
  USER
  ASSISTANT
}

/// Una conversación con el copiloto (Sprint 6).
///
/// El hilo guarda **con qué se habló** además de los mensajes: cambiar de
/// proveedor o de nivel a mitad de conversación es legítimo —empezar en `light`
/// y subir a `pro` cuando la cosa se pone seria— y sin este registro no habría
/// forma de saber quién escribió cada respuesta al releerla.
model ChatThread {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  /// Se compone del primer mensaje; es lo que se pinta en la lista de hilos.
  title     String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  /// Se toca en cada turno: la lista se ordena por conversación reciente, no por creación.
  updatedAt DateTime      @updatedAt

  /// La lista del panel pregunta siempre "mis hilos, del más reciente al más antiguo".
  @@index([userId, updatedAt])
}

model ChatMessage {
  id        String     @id @default(cuid())
  threadId  String
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  /// Con qué se generó la respuesta. `null` en los mensajes del usuario.
  provider  String?
  model     String?
  createdAt DateTime   @default(now())

  /// Se leen siempre en orden, para rehidratar la conversación.
  @@index([threadId, createdAt])
}

/// Rastro de lo que el copiloto hizo de verdad (Sprint 6, nombrado por Doc).
///
/// No es el log del proceso: eso se rota y se pierde. Esto responde meses
/// después a "quién mandó ese correo y qué decía", que es la pregunta que
/// aparece cuando algo sale mal — y la razón por la que importa está en las
/// acciones que salen hacia afuera o destruyen algo.
model CopilotAuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// Qué herramienta o acción: `draft_email`, `create_task`, `send_email`…
  toolName  String
  /// Los argumentos con los que se ejecutó, tal cual llegaron.
  arguments Json
  /// Qué salió: el id del correo enviado, el de la tarea creada, o el error.
  result    Json?
  /// `false` cuando la acción falló; el motivo va en `result`.
  ok        Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Email {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  gmailMessageId String    @unique
  threadId       String
  from           String
  subject        String?
  snippet        String?
  bodyText       String?
  labels         String[]
  category       String?
  isActionable   Boolean   @default(false)
  /// Triage de la persona. Nace `PENDING` y solo lo mueve ella.
  status         EmailStatus @default(PENDING)
  receivedAt     DateTime
  processedAt    DateTime?
  tasks          Task[]

  @@index([threadId])
  /// La bandeja pregunta siempre por "lo mío que sigue pendiente".
  @@index([userId, status])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  sourceEmail   Email?       @relation(fields: [sourceEmailId], references: [id])
  sourceEmailId String?
  /// El default es `MANUAL` a propósito: si algún sitio olvida fijarlo, la
  /// tarea queda protegida del borrado por reproceso en vez de expuesta.
  source        TaskSource   @default(MANUAL)
  aiConfidence  Float?
  /// Etiquetas libres que extrae el modelo del texto del correo ("TC", "KYC").
  /// Son texto suelto a propósito: nacen de cada análisis, no tienen dueño ni
  /// color. No confundir con `labels`, que son las de la persona.
  tags          String[]
  /// Etiquetas curadas por la persona, con color y reutilizables entre tareas.
  labels        Tag[]
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  timeEntries   TimeEntry[]

  @@index([userId, status])
}

/// Etiqueta que crea y reutiliza la persona, con su color.
///
/// Convive con `Task.tags`, el arreglo de texto libre que saca el modelo de
/// cada correo. No se fusionan a propósito: las del modelo nacen y mueren con
/// cada análisis y llenarían de ruido la lista del usuario; estas las escribe
/// una persona y esperan seguir ahí mañana.
model Tag {
  id        String   @id @default(cuid())
  name      String
  /// Hexadecimal `#RRGGBB`. Se valida en el DTO, no aquí.
  color     String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tasks     Task[]
  createdAt DateTime @default(now())

  /// Dos etiquetas con el mismo nombre para la misma persona serían
  /// indistinguibles en cualquier desplegable.
  @@unique([userId, name])
}

/// Un fichaje sobre una tarea. Mientras corre, `endedAt` y `durationSec` son
/// `null`; al detenerlo se rellenan los dos.
model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  startedAt   DateTime
  endedAt     DateTime?
  /// Segundos entre `startedAt` y `endedAt`. Se guarda en vez de calcularse en
  /// cada lectura para que el informe sume en la base y no en memoria.
  durationSec Int?
  note        String?
  /// Centinela del timer en marcha: lleva el `userId` mientras corre y vuelve a
  /// `null` al detenerlo.
  ///
  /// Existe para que "un solo timer activo por persona" la arbitre la base y no
  /// una comprobación entre leer y escribir, que dejaría pasar dos pestañas
  /// pulsando play a la vez. Postgres considera distintos todos los `NULL` en
  /// un índice único, así que caben cuantos fichajes cerrados haga falta y solo
  /// uno abierto por dueño. No se usa un índice único parcial
  /// (`WHERE "endedAt" IS NULL`) porque Prisma no sabe expresarlo y lo
  /// borraría en la siguiente migración.
  activeFor   String?   @unique

  /// El informe pregunta por rangos de fechas de una persona.
  @@index([userId, startedAt])
  /// Y la tarjeta, por los fichajes de su tarea.
  @@index([taskId])
}
