// Esquema de datos del PMO Dashboard — ver ARCHITECTURE.md §4.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  POSTPONED
  DONE
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// De dónde salió la tarea. `EMAIL` es la única que el reproceso automático
/// puede borrar y recrear; el resto son de una persona y no se tocan.
enum TaskSource {
  EMAIL
  WHATSAPP
  MANUAL
}

/// En qué punto del triage está el correo (Inbox Zero).
///
/// Es una decisión de la persona y no del sistema: `processedAt` dice que el
/// worker ya lo analizó, que es otra cosa. Un correo puede estar procesado por
/// la IA y seguir `PENDING` para su dueño.
enum EmailStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DISMISSED
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  googleTokens   String? // cifrado en reposo (AES-256-GCM)
  /// Último `historyId` de Gmail sincronizado: punto de partida de la sync incremental.
  gmailHistoryId String?
  whatsappNumber String?
  role           String       @default("owner")
  createdAt      DateTime     @default(now())
  emails         Email[]
  tasks          Task[]
  timeEntries    TimeEntry[]
}

model Email {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  gmailMessageId String    @unique
  threadId       String
  from           String
  subject        String?
  snippet        String?
  bodyText       String?
  labels         String[]
  category       String?
  isActionable   Boolean   @default(false)
  /// Triage de la persona. Nace `PENDING` y solo lo mueve ella.
  status         EmailStatus @default(PENDING)
  receivedAt     DateTime
  processedAt    DateTime?
  tasks          Task[]

  @@index([threadId])
  /// La bandeja pregunta siempre por "lo mío que sigue pendiente".
  @@index([userId, status])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  sourceEmail   Email?       @relation(fields: [sourceEmailId], references: [id])
  sourceEmailId String?
  /// El default es `MANUAL` a propósito: si algún sitio olvida fijarlo, la
  /// tarea queda protegida del borrado por reproceso en vez de expuesta.
  source        TaskSource   @default(MANUAL)
  aiConfidence  Float?
  tags          String[]
  position      Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  timeEntries   TimeEntry[]

  @@index([userId, status])
}

model TimeEntry {
  id          String    @id @default(cuid())
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int?
  note        String?
}
