# Dependencias
node_modules/
**/node_modules/

# Entorno / secretos
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Credenciales y volcados sueltos.
#
# Estas tres lineas se anadieron el 2026-08-18 tras aparecer en la raiz un
# dump.sql de produccion y un new_db_url.txt con la cadena de conexion. El
# primer intento se escribio en UTF-16 dentro de este archivo UTF-8: git cortaba
# el patron en el primer byte nulo y quedaba un `*` suelto que ignoraba el
# repositorio entero, incluido apps/. Parecia que protegia; lo que hacia era
# tapar todo. Si hay que tocarlas, en UTF-8 sin BOM.
*db_url*
*.sql
*.dump
cloud-sql-proxy*
!apps/api/prisma/migrations/**/*.sql

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo

# Artefactos de compilacion de configs (tsc -b sobre vite.config.ts)
apps/web/vite.config.js
apps/web/vite.config.d.ts

# Prisma
apps/api/prisma/*.db

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*

# Editor / SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

